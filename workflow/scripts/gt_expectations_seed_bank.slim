// ============================================================================
//  NonWF Seed Bank Simulation
// ============================================================================
//
//  OVERVIEW
//  --------
//  Models a population with two distinct life-history compartments:
//
//    p1  –  "seed storage"  : dormant/overwintering pool (e.g. seed/egg seed).
//              Individuals persist across ticks, age annually, and experience
//              age-based mortality.
//
//    p2  –  breeding pool   : active adults recruited from seed storage each
//              tick.  They reproduce once and then die (semelparity).
//
//  TICK CYCLE (each tick T)
//  ------------------------
//    1. reproduction(p2) — each p2 individual generates N_OFFSPRING offspring
//       that are deposited directly into seed storage (p1) at age 0.
//    2. early()          — (a) mark last cycle's p2 for death (fitnessScaling=0),
//                          (b) move age-eligible p1 individuals to p2 according
//                              to GERM_RATE,
//                          (c) apply logistic density-dependence to new p2,
//                          (d) set age-based survival for p1 individuals.
//    3. Viability/survival selection (automatic) — SLiM applies fitnessScaling
//       values set in step 2 to determine who lives and who dies.
//    4. late()           — report population statistics; check stop condition.
//    5. Age increment (automatic) — all surviving individuals gain +1 age.
//
//  VCF REQUIREMENTS
//  ----------------
//  The VCF must contain exactly N_VCF diploid individuals (2*N_VCF haplotypes).
//  All SNP positions must be <= CHROM_LEN.
// ============================================================================

// Started by borrowing code from Vince Buffalo and modifying/updating it to
// work with newest version of slim (v5.1 as of writing)
// https://github.com/vsbuffalo/cvtk/blob/master/slim_sims/neutral_burnin.slim
function (void)write_freqs(string file, object<Subpopulation> subpop,
                     object<MutationType> mut_type, integer generation) {
  fmt_freqs='applyValue.id + ";" + applyValue.position + ";" + sim.mutationFrequencies(subpop, applyValue);';
  line = paste(sapply(sim.mutationsOfType(mut_type), fmt_freqs), sep="\t");
  writeFile(file, generation + "\t" + line, append=T);
}

initialize() {

    initializeSLiMModelType("nonWF");
    initializeSLiMOptions(nucleotideBased=T);
    length = initializeAncestralNucleotides(FASTA_FILE);
    defineConstant("CHROM_LEN", length);
    // ── Genetic architecture ─────────────────────────────────────────────────
    // convertToSubstitution must be set explicitly to T in nonWF models
    // (it defaults to F, unlike WF models, because absolute fitness values
    // in nonWF models make it generally unsafe to remove fixed mutations
    // automatically — see SLiM Manual §25.5).
    initializeMutationTypeNuc("m1", 0.5, "f", 0.0);
    initializeMutationTypeNuc("m2", 0.5, "f", 0.0);
    initializeMutationTypeNuc("m3", 0.5, "f", 0.0);
    m1.convertToSubstitution = T;

    if(STRUCTURE == 1) {
        initializeGenomicElementType("g1", m1, 1.0, mmJukesCantor(0.0));
    } else {
        mut_props = c(1.0, (TMU/NMU)*SURVIVAL_SELECTION, (TMU/NMU)*(1-SURVIVAL_SELECTION));
        initializeGenomicElementType("g1", c(m1,m2,m3), mut_props, mmJukesCantor(NMU/3));
    }
    initializeGenomicElement(g1, 0, CHROM_LEN-1);
    initializeRecombinationRate(R);
}


// ============================================================================
//  REPRODUCTION  (fires once per p2 individual, before early() each tick)
// ============================================================================
//
//  Each breeding individual (p2) generates N_OFFSPRING offspring.  Critically,
//  offspring are added to p1 (seed storage), NOT to subpop (which would be p2).
//  New offspring start at age 0 and are therefore ineligible for immediate
//  recruitment to p2 (requires age >= MIN_AGE).

reproduction(p2) {
    //catn("Individual fitness: " + individual.fitnessScaling);
    if(STRUCTURE == 0 & sim.cycle <= BURN){
        REALIZED_FITNESS = N_OFFSPRING;
    } else {
        REALIZED_FITNESS = pmax(0.0, N_OFFSPRING*(1 + individual.sumOfMutationsOfType(m3)));
    }

    REALIZED_OFFSPRING = rpois(1, REALIZED_FITNESS);

    for (i in seqLen(REALIZED_OFFSPRING)) {
        if (runif(1) > SIGMA){
            mate = p2.sampleIndividuals(1);       // random mating within p2
            p1.addCrossed(individual, mate);      // offspring land in seed storage
        } else {
            p1.addSelfed(individual);
        }
    }
}

// ============================================================================
//  INITIALIZATION  (tick 1 only)
// ============================================================================

1 early() {
    catn("=== Cold Storage NonWF Simulation ===");
    catn("Parameters:");
    catn("  FASTA_FILE  = " + FASTA_FILE);
    catn("  VCF_FILE    = " + VCF_FILE);
    catn("  N_VCF       = " + N_VCF);
    catn("  K           = " + K);
    catn("  GERM_RATE   = " + GERM_RATE);
    catn("  MIN_AGE     = " + MIN_AGE);
    catn("  MAX_BANK_AGE= " + MAX_BANK_AGE);
    catn("  BANK_SURV   = " + BANK_SURV);
    catn("  N_OFFSPRING = " + N_OFFSPRING);
    catn("  SIM_LENGTH  = " + SIM_LENGTH);
    catn("  SIGMA       = " + SIGMA);
    catn("  ALPHA       = " + ALPHA);
    catn("  STRUCTURE   = " + STRUCTURE);
    catn("  BURN        = " + BURN);
    catn("=====================================");

    // Create seed storage with exactly N_VCF diploid individuals.
    sim.addSubpop("p1", N_VCF);

    // Create an initially empty breeding population.
    sim.addSubpop("p2", 0);
    
    catn("Tick 1: " + p1.individualCount + " individuals loaded into seed storage.");

    if (STRUCTURE == 1) {
         catn("Tick 1: Creating initial seed bank WITH population structure.");
        // Load standing genetic variation from VCF into seed storage.
        p1.individuals.readIndividualsFromVCF(VCF_FILE, m1);
        
        // reschedule population tracking until initial generations
        community.rescheduleScriptBlock(s1, start=2, end=SIM_LENGTH);
        community.rescheduleScriptBlock(s2, start=2, end=SIM_LENGTH);
        community.rescheduleScriptBlock(s3, start=SIM_LENGTH+1); // move burn-in code to end of simulation
        community.rescheduleScriptBlock(s4, start=SIM_LENGTH+1); // burn-in not needed

        catn("Tick 1: " + p1.individualCount + " individuals loaded into seed storage.");
        catn("Tick 1: No burn-in will be performed and BURN is ignored.");

        catn("Tick 1: Sampling mutations to be selected.");
        num_mut = asInteger(4*TMU*N_VCF*CHROM_LEN);
        sampled = sample(sim.mutations, num_mut);
        catn("Tick 1: Sampled mutations: " + length(sampled));
        for (mut in sampled) {
            if (runif(1) < SURVIVAL_SELECTION){
                mut.setMutationType(m2);
            } else {
                mut.setMutationType(m3);
            }
            if (runif(1) < 0.5) {
                mut.setSelectionCoeff(ALPHA);
            } else {
                mut.setSelectionCoeff(-ALPHA);
            }
        }
    } else {
        catn("Tick 1: Creating initial seed bank WITHOUT population structure.");
        // reschedule population tracking until initial generations
        community.rescheduleScriptBlock(s1, start=2, end=BURN+1+SIM_LENGTH);
        community.rescheduleScriptBlock(s2, start=2, end=BURN+1+SIM_LENGTH);
        community.rescheduleScriptBlock(s3, start=1, end=BURN);
        community.rescheduleScriptBlock(s4, start=1, end=BURN);
        catn("Tick 1: Set burn-in for " + BURN + " generations.");
    }
}

//===================================================================================
// MUTATION CALLBACKS (makes mutations neutral during burn-in, and non-neutral after)
//===================================================================================

s3 500 mutationEffect(m2) {
  return 1.0;
}

s4 500 mutationEffect(m3) {
  return 1.0;
}

// ============================================================================
//  PER-TICK LIFE-HISTORY LOGIC  (runs every tick, after reproduction())
// ============================================================================

s1 300 early() {
    catn("Tick " + sim.cycle + ": " + "Beginning of early phase.");
    catn("Tick " + sim.cycle + ": " + "Number of seeds: " + p1.individualCount + ", Number of plants: " + p2.individualCount);
    // Skip tick 1; initialisation was handled by the block above.
    if (community.tick == 1) return;

    // ── A.  Kill last cycle's breeders ───────────────────────────────────────
    //
    //  p2 individuals already reproduced (in this tick's reproduction() phase).
    //  Setting fitnessScaling = 0.0 ensures they die during SLiM's viability/
    //  survival phase later this tick.  Effective fitness = 0 × p2.fitnessScaling
    //  = 0, regardless of any subpopulation-level scaling.
    catn("Tick " + sim.cycle + ": " + "killing breeders from last cycle.");
    if (p2.individualCount > 0)
        p2.individuals.fitnessScaling = 0.0;

    catn("Tick " + sim.cycle + ": " + "Number of seeds: " + p1.individualCount + ", Number of plants: " + p2.individualCount);
    
    // ── B.  Recruit eligible seed-storage individuals into p2 ────────────────
    //
    //  Eligible:  MIN_AGE <= age < MAX_BANK_AGE
    //  Sample:    GERM_RATE fraction of eligible, with a minimum of 1 if
    //             any are eligible (prevents complete stagnation when counts
    //             are small).
    catn("Tick " + sim.cycle + ": " + "sprouting some seeds.");
    seed = p1.individuals;

    if (seed.size() > 0) {
        eligible_mask = (seed.age >= MIN_AGE) & (seed.age < MAX_BANK_AGE);
        eligible = seed[eligible_mask];
        if (eligible.size() > 0) {
            n_move = max(1, asInteger(round(eligible.size() * GERM_RATE)));
            n_move = min(n_move, eligible.size());
            movers = sample(eligible, n_move, replace = F);
            catn("Tick " + sim.cycle + ": " + "Eligible seeds: " + eligible.size() + " Germinating seeds: " + n_move);

            // Move individuals from seed storage to the breeding population.
            p2.takeMigrants(movers);

            // ── C.  Density-dependent survival for new breeders ───────────────
            //
            //  Logistic density dependence: survival probability is capped at 1.0
            //  below carrying capacity, and decreases as K / n_planters when
            //  n_planters > K.  Setting individual fitnessScaling overrides the
            //  fitnessScaling these individuals carried from seed storage.
            //
            //  Note: p2.fitnessScaling remains at its default of 1.0, so effective
            //  fitness for each new breeder = dd_surv × 1.0 = dd_surv.
            n_plant = movers.size();
            dd_surv = (n_plant > 0) ? min(1.0, K / n_plant) else 1.0;
            movers.fitnessScaling = dd_surv;
        }
    }
    catn("Tick " + sim.cycle + ": " + "Number of seeds: " + p1.individualCount + ", Number of plants: " + p2.individualCount);

    // ── D.  Age-based mortality for seed storage (p1) ────────────────────────
    //
    //  After movers have left, apply survival values to the remaining p1
    //  individuals.  SLiM interprets fitnessScaling in [0,1] as a survival
    //  probability in nonWF models.
    catn("Tick " + sim.cycle + ": " + "Marking seeds for death.");
    seed_remaining = p1.individuals;
    seed_m2_effect_sum = p1.individuals.sumOfMutationsOfType(m2);

    if (seed_remaining.size() > 0) {
        // catn("Tick " + sim.cycle + ": " + "Mean seed fitness: " + mean(seed_m2_effect_sum));
        // Default annual survival for individuals within the viable age range.
        if(STRUCTURE == 0 & sim.cycle <= BURN){
            seed_remaining.fitnessScaling = BANK_SURV; // during burn-in just apply base survival
        } else {
            seed_remaining.fitnessScaling = pmax(0.0, pmin(1.0, BANK_SURV + seed_m2_effect_sum));
        }

        //seed_remaining.fitnessScaling = pmax(0.0, pmin(1.0, BANK_SURV + seed_m2_effect_sum));
        //seed_remaining.fitnessScaling = BANK_SURV;

        // Force-kill individuals that have exceeded the maximum seed-storage age.
        too_old = seed_remaining[seed_remaining.age >= MAX_BANK_AGE];
        if (too_old.size() > 0)
            too_old.fitnessScaling = 0.0;
    }
    catn("Tick " + sim.cycle + ": Min seed fitness: " + min(seed_remaining.fitnessScaling) + ", Mean seed fitness: " + mean(seed_remaining.fitnessScaling) + ", Max seed fitness: " + max(seed_remaining.fitnessScaling));
    catn("Tick " + sim.cycle + ": " + "Number of seeds: " + p1.individualCount + ", Number of plants: " + p2.individualCount);
}


// ============================================================================
//  OUTPUT  (late, after viability selection each tick)
// ============================================================================

s2 300 late() {
    
    tick = community.tick;
    n_seed  = p1.individualCount;
    n_plant = p2.individualCount;

    if(STRUCTURE == 1){
        write_freqs("slim_results/" + ID + "_neutfreqs.tsv", p2, m1, sim.cycle);
    }

    if((STRUCTURE == 0) & (tick >= BURN+1)){
        write_freqs("slim_results/" + ID + "_neutfreqs.tsv", p2, m1, sim.cycle);
    }

    // Detect extinction.
    if (n_seed == 0 & n_plant == 0) {
        catn(tick + ": EXTINCTION – both populations empty. Simulation halted.");
        sim.simulationFinished();
        return;
    }

    // Per-tick statistics line.
    if (n_seed > 0 & n_plant > 0) {
        seed_ages           = p1.individuals.age;
        plant_ages          = p2.individuals.age;
        plant_mean_age      = round(mean(plant_ages));
        plant_max_age       = max(plant_ages);
        seed_mean_age       = round(mean(seed_ages));
        seed_max_age        = max(seed_ages);
        seed_m2_count       = max(p1.individuals.countOfMutationsOfType(m2));
        seed_m3_count       = max(p1.individuals.countOfMutationsOfType(m3));
        seed_mean_pheno     = mean(p2.individuals.sumOfMutationsOfType(m2) + p2.individuals.countOfMutationsOfType(m3) + sum(sim.substitutions.selectionCoeff));
        plant_m2_count      = max(p2.individuals.countOfMutationsOfType(m2));
        plant_m3_count      = max(p2.individuals.countOfMutationsOfType(m3));
        plant_mean_pheno    = mean(p1.individuals.sumOfMutationsOfType(m2) + p1.individuals.countOfMutationsOfType(m3) + sum(sim.substitutions.selectionCoeff));
        catn("Tick " + tick + ": seeds=" + n_seed +
             " plants=" + n_plant +
             " seed_mean_age=" + seed_mean_age +
             " seed_max_age="  + seed_max_age + 
             " seed_m2_count=" + seed_m2_count +
             " seed_m3_count=" + seed_m3_count +
             " seed_mean_pheno=" + seed_mean_pheno +
             " plant_mean_age=" + plant_mean_age + 
             " plant_max_age=" + plant_max_age +
             " plant_m2_count=" + plant_m2_count +
             " plant_m3_count=" + plant_m3_count + 
             " plant_mean_pheno=" + plant_mean_pheno);
    } else {
        catn("Tick " + tick + ": seeds=" + n_seed + " plants=" + n_plant);
    }

    // End of scheduled run.
    if(STRUCTURE == 0){
        if(tick >= BURN+1+SIM_LENGTH){
            catn("=== Simulation reached tick " + tick + " – finished. ===");
            sim.simulationFinished();
        }
    } else {
        if (SIM_LENGTH > 0 & tick >= SIM_LENGTH) {
            catn("=== Simulation reached tick " + tick + " – finished. ===");
            sim.simulationFinished();
        }
    }
}

